#include <stdio.h>

int n;
int e[10][10];
int visited[10];

void epsilonClosure(int state)
{
    int i;

    if (visited[state])
        return;

    visited[state] = 1;
    printf("q%d ", state);

    for (i = 0; i < n; i++)
    {
        if (e[state][i] == 1)
            epsilonClosure(i);
    }
}

int main()
{
    int i, j;

    printf("Enter number of states: ");
    scanf("%d", &n);

    printf("Enter epsilon transition matrix (0/1):\n");

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &e[i][j]);

    for (i = 0; i < n; i++)
    {
        for (j = 0; j < n; j++)
            visited[j] = 0;

        printf("\nEpsilon Closure(q%d) = { ", i);
        epsilonClosure(i);
        printf("}\n");
    }

    return 0;
}
